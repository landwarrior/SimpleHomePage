{
    // Biome設定ファイルのスキーマ定義
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    // === バージョン管理システム設定 ===
    "vcs": {
        "enabled": true, // VCS統合を有効化（Gitの設定を自動検出）
        "clientKind": "git", // 使用するVCSクライアントの種類
        "useIgnoreFile": true // .gitignoreファイルを利用してファイルを無視
    },
    // === ファイル設定 ===
    "files": {
        "ignoreUnknown": false // 未知のファイルタイプを無視しない（すべてのファイルを処理対象とする）
    },
    // === フォーマッター設定 ===
    // コードの自動フォーマットに関する設定
    "formatter": {
        "enabled": true, // フォーマッターを有効化
        "formatWithErrors": false, // エラーがあってもフォーマットを実行しない
        "indentStyle": "space", // インデントスタイル: スペースを使用
        "indentWidth": 4, // インデント幅: 4スペース
        "lineEnding": "lf", // 改行コード: LF（Unix形式）
        "lineWidth": 200, // 1行の最大文字数: 200文字
        "attributePosition": "auto", // HTML/JSX属性の位置: "auto"（自動）、"multiline"（複数行）
        "bracketSameLine": false, // 開始ブラケットを同じ行に配置しない
        "bracketSpacing": true, // オブジェクトリテラルの波括弧内にスペースを入れる
        "expand": "auto", // 配列やオブジェクトの展開: "auto"（自動）、"always"（常に）、"never"（しない）
        "useEditorconfig": true // .editorconfigファイルの設定を読み込む
    },
    // === リンター設定 ===
    // コードの静的解析とエラーチェックに関する設定
    "linter": {
        "enabled": true, // リンターを有効化
        "rules": {
            "preset": "recommended", // Biome推奨ルールを土台にする。以下の個別指定で深刻度を上書きする
            // === 複雑度に関するルール ===
            "complexity": {
                "noArguments": "error", // argumentsオブジェクトの使用を禁止（prefer-rest-params相当）（推奨のデフォルトは warn）
                "noUselessConstructor": "error", // 不要なコンストラクタを禁止（no-useless-constructor相当）（推奨のデフォルトは info）
                "noUselessRename": "error", // 不要な名前変更を禁止（no-useless-rename相当）（推奨のデフォルトは info）
                "useLiteralKeys": "error", // リテラルキーの使用を推奨（推奨のデフォルトは info）
                "noAdjacentSpacesInRegex": "error", // 正規表現内の隣接するスペースを禁止（推奨のデフォルトは warn）
                "noExtraBooleanCast": "error", // 不要なBooleanキャストを禁止（推奨のデフォルトは info）
                "noUselessCatch": "error", // 不要なcatchブロックを禁止（推奨のデフォルトは info）
                "noUselessEscapeInRegex": "error", // 正規表現内の不要なエスケープを禁止（推奨のデフォルトは info）
                "noUselessFragments": "warn" // 不要なフラグメントを禁止（推奨のデフォルトは info）
            },
            // === 正確性に関するルール ===
            "correctness": {
                // "noConstAssign": "error", // const変数への再代入を禁止（推奨と同じ設定）
                // "noConstantCondition": "error", // 定数条件を禁止（推奨と同じ設定）
                // "noEmptyCharacterClassInRegex": "error", // 空の文字クラスを正規表現で禁止（推奨と同じ設定）
                // "noEmptyPattern": "error", // 空のパターンを禁止（推奨と同じ設定）
                // "noGlobalObjectCalls": "error", // グローバルオブジェクトの関数呼び出しを禁止（推奨と同じ設定）
                // "noInvalidBuiltinInstantiation": "error", // 無効な組み込みオブジェクトのインスタンス化を禁止（推奨と同じ設定）
                // "noInvalidConstructorSuper": "error", // 無効なコンストラクタのsuper呼び出しを禁止（推奨と同じ設定）
                // "noNonoctalDecimalEscape": "error", // 非8進数の10進数エスケープを禁止（推奨と同じ設定）
                // "noPrecisionLoss": "error", // 精度の損失を禁止（推奨と同じ設定）
                // "noSelfAssign": "error", // 自己代入を禁止（推奨と同じ設定）
                // "noSetterReturn": "error", // setterでのreturnを禁止（推奨と同じ設定）
                // "noSwitchDeclarations": "error", // switch文内の宣言を禁止（推奨と同じ設定）
                "noUndeclaredVariables": "error", // 未宣言変数の使用を禁止
                // "noUnreachable": "error", // 到達不能コードを禁止（推奨と同じ設定）
                // "noUnreachableSuper": "error", // 到達不能なsuper呼び出しを禁止（推奨と同じ設定）
                // "noUnsafeFinally": "error", // 安全でないfinallyブロックを禁止（推奨と同じ設定）
                // "noUnsafeOptionalChaining": "error", // 安全でないオプショナルチェーンを禁止（推奨と同じ設定）
                "noUnusedLabels": "error", // 未使用のラベルを禁止（推奨のデフォルトは warn）
                "noUnusedPrivateClassMembers": "error", // 未使用のプライベートクラスメンバーを禁止（推奨のデフォルトは warn）
                "noUnusedVariables": "error" // 未使用変数を禁止（推奨のデフォルトは warn）
                // "useIsNan": "error", // NaNチェックにはisNaN()を使用（推奨と同じ設定）
                // "useValidForDirection": "error", // 有効なforループの方向を使用（推奨と同じ設定）
                // "useValidTypeof": "error", // 有効なtypeof演算子を使用（推奨と同じ設定）
                // "useYield": "error", // ジェネレータ関数ではyieldを使用（推奨と同じ設定）
            },
            // コードの一貫性やスタイルに関するルールを有効化する項目
            "style": {
                "useConst": "error" // constの使用を強制（再代入されない変数）（推奨のデフォルトは warn）
            },
            // === 疑わしいコードパターンに関するルール ===
            "suspicious": {
                // "noAssignInExpressions": "error", // 式内での代入を禁止（推奨と同じ設定）
                // "noAsyncPromiseExecutor": "error", // 非同期Promiseエグゼキューターを禁止（推奨と同じ設定）
                "noCatchAssign": "error", // catch句での変数代入を禁止（推奨のデフォルトは warn）
                // "noClassAssign": "error", // クラスの再代入を禁止（推奨と同じ設定）
                // "noCompareNegZero": "error", // -0との比較を禁止（推奨と同じ設定）
                "noConstantBinaryExpressions": "error", // 定数の二項式を禁止
                // "noControlCharactersInRegex": "error", // 正規表現内の制御文字を禁止（推奨と同じ設定）
                // "noDebugger": "error", // debugger文を禁止（推奨と同じ設定）
                // "noDuplicateCase": "error", // switch文の重複したcaseを禁止（推奨と同じ設定）
                // "noDuplicateClassMembers": "error", // 重複したクラスメンバーを禁止（推奨と同じ設定）
                // "noDuplicateElseIf": "error", // 重複したelse ifを禁止（推奨と同じ設定）
                // "noDuplicateObjectKeys": "error", // 重複したオブジェクトキーを禁止（推奨と同じ設定）
                // "noDuplicateParameters": "error", // 重複したパラメータを禁止（推奨と同じ設定）
                "noEmptyBlockStatements": "error", // 空のブロック文を禁止
                // "noFallthroughSwitchClause": "error", // switch文のフォールスルーを禁止（推奨と同じ設定）
                // "noFunctionAssign": "error", // 関数の再代入を禁止（推奨と同じ設定）
                "noConsole": "warn", // consoleの使用を警告（no-console: warn相当）
                // "noGlobalAssign": "error", // グローバル変数への再代入を禁止（no-global-assign相当）（推奨と同じ設定）
                // "noImportAssign": "error", // importの再代入を禁止（推奨と同じ設定）
                "noIrregularWhitespace": "error", // 不正な空白文字を禁止（推奨のデフォルトは warn）
                // "noMisleadingCharacterClass": "error", // 誤解を招く文字クラスを禁止（推奨と同じ設定）
                "noPrototypeBuiltins": "error", // プロトタイプの組み込みメソッドを禁止（推奨のデフォルトは warn）
                // "noRedeclare": "error", // 再宣言を禁止（推奨と同じ設定）
                // "noShadowRestrictedNames": "error", // 制限された名前のシャドウを禁止（推奨と同じ設定）
                // "noSparseArray": "error", // スパース配列を禁止（推奨と同じ設定）
                // "noUnsafeNegation": "error", // 安全でない否定を禁止（推奨と同じ設定）
                "noUselessRegexBackrefs": "error" // 無意味な正規表現の後方参照を禁止（推奨のデフォルトは warn）
                // "noWith": "error", // with文を禁止（推奨と同じ設定）
                // "useGetterReturn": "error", // getterでreturn文を使用（推奨と同じ設定）
            }
        },
        // リンターの対象ファイル: すべてのファイル（node_modulesとdistを除く）
        "includes": ["**", "!node_modules/**", "!dist/**", "!new-homepage/node_modules/**", "!new-homepage/dist/**"]
    },
    // === JavaScript設定 ===
    "javascript": {
        "formatter": {
            "jsxQuoteStyle": "double", // JSX属性のクォートスタイル: "double"（ダブルクォート）
            "quoteProperties": "asNeeded", // オブジェクトプロパティのクォート: "asNeeded"（必要な場合のみ）
            "trailingCommas": "es5", // 末尾のカンマ: "es5"（ES5互換）、"all"（常に）、"none"（なし）
            "semicolons": "always", // セミコロン: "always"（常に）、"asNeeded"（必要な場合のみ）
            "arrowParentheses": "always", // アロー関数の括弧: "always"（常に）、"asNeeded"（必要な場合のみ）
            "bracketSameLine": false, // 開始ブラケットを同じ行に配置しない
            "quoteStyle": "single", // 文字列のクォートスタイル: "single"（シングルクォート）
            "attributePosition": "auto", // JSX属性の位置: "auto"（自動）
            "bracketSpacing": true // オブジェクトリテラルの括弧内にスペースを入れる
        },
        // グローバル変数: デフォルトでは空（overridesで設定）
        "globals": []
    },
    // === HTML設定 ===
    // HTMLファイルのフォーマット設定
    "html": {
        "formatter": {
            "indentScriptAndStyle": false, // <script>と<style>タグ内をインデントしない
            "selfCloseVoidElements": "never" // 空要素を常に自己閉じタグにしない（<br>のまま）
        },
        "experimentalFullSupportEnabled": true // Vueファイルなどの埋め込みスクリプトの完全サポートを有効化
    },
    // === CSS設定 ===
    // CSSファイルのパーサー設定
    "css": {
        "parser": {
            "tailwindDirectives": true // Tailwind CSS v4の構文（@custom-variant、@applyなど）を許可
        }
    },
    // === オーバーライド設定 ===
    // 特定のファイルパターンに対して設定を上書き
    "overrides": [
        // Vueファイル用の設定
        {
            "includes": ["*.vue", "**/*.vue"],
            "linter": {
                "rules": {
                    // Vueの<script setup>では、テンプレート内で使用される変数が
                    // Biomeによって認識されないため、未使用変数のチェックを無効化
                    "correctness": {
                        "noUnusedVariables": "off"
                    }
                }
            }
        },
        // new-homepageディレクトリ内のファイル用の設定（TypeScript対応）
        {
            "includes": ["new-homepage/**/*.{js,mjs,cjs,ts,tsx,vue}"],
            "javascript": {
                // Vueとflatpickrをグローバル変数として認識
                "globals": ["Vue", "flatpickr"]
            }
        },
        // HTMLファイル専用の設定
        {
            "includes": ["*.html"],
            "formatter": {
                "indentWidth": 2 // HTMLファイルのインデント幅を2に設定
            }
        },
        // ルートの旧サイト。デプロイ対象外のため、推奨ルールの a11y は適用しない
        {
            "includes": ["index.html", "mhw_kaishin.html", "!new-homepage/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "preset": "none"
                    }
                }
            }
        }
    ],
    // === アシスト機能設定 ===
    // エディタの自動補完やインポート整理などの機能
    "assist": {
        "enabled": true, // アシスト機能を有効化
        "actions": {
            "source": {
                "organizeImports": "on" // インポート文を自動整理
            }
        }
    }
}
